# Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hp_home_improvements

# Server
PORT=5000
NODE_ENV=development

# JWT (CRITICAL: Change this to a random 32+ character string in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this

# CORS: Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://frontend-gold-ten-70.vercel.app

# Cloudinary (for photo uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Google Calendar (optional, for sync)
GOOGLE_CALENDAR_API_KEY=your-google-api-key
